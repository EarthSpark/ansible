
x-logging: &default_logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "3"

services:
  # Metering provider: the SparkNet controller core with an HTTP+SSE API.
  # It drives the gateway radio over the host's serial device and serves the API
  # on port 8080, which the webapp reaches via METERING_PROVIDER_URL. Configured
  # declaratively through SPARKNET_HTTP_* env vars, which the image entrypoint
  # maps to CLI flags. Runs privileged so the host's /dev and /sys are visible —
  # this replaces device/group passthrough uniformly across gateways.
  #
  # The resolved SPARKNET_HTTP_* env is rendered into a readable env_file (the
  # selected gateway_configs entry merged with any per-host overrides plus the
  # fixed BIND), so this service definition stays static across every gateway.
  sparknet-http:
    image: {{ sparknet_http_image }}
    privileged: true
    env_file:
      - {{ compose_env_dir }}/sparknet-http.env
    networks:
      - sparkapp
    logging: *default_logging
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:8080/healthz >/dev/null 2>&1 || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 10

networks:
  sparkapp:
    external: true
