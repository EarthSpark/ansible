# Resolved sparknet-http gateway config. Built from the selected gateway_configs
# entry (whose keys ARE the SPARKNET_HTTP_* names) merged with any explicit
# per-host SPARKNET_HTTP_* override vars that are defined AND non-empty
# (overrides win; a blank override does NOT clobber the dict value).
{% set env = gateway_configs[gateway] | default({}) %}
{% set overrides = {} %}
{% if SPARKNET_HTTP_DEVICE is defined and SPARKNET_HTTP_DEVICE | string | length > 0 %}{% set _ = overrides.update({'SPARKNET_HTTP_DEVICE': SPARKNET_HTTP_DEVICE}) %}{% endif %}
{% if SPARKNET_HTTP_GATEWAY_TYPE is defined and SPARKNET_HTTP_GATEWAY_TYPE | string | length > 0 %}{% set _ = overrides.update({'SPARKNET_HTTP_GATEWAY_TYPE': SPARKNET_HTTP_GATEWAY_TYPE}) %}{% endif %}
{% if SPARKNET_HTTP_RESET_METHOD is defined and SPARKNET_HTTP_RESET_METHOD | string | length > 0 %}{% set _ = overrides.update({'SPARKNET_HTTP_RESET_METHOD': SPARKNET_HTTP_RESET_METHOD}) %}{% endif %}
{% if SPARKNET_HTTP_BOOTLOADER_METHOD is defined and SPARKNET_HTTP_BOOTLOADER_METHOD | string | length > 0 %}{% set _ = overrides.update({'SPARKNET_HTTP_BOOTLOADER_METHOD': SPARKNET_HTTP_BOOTLOADER_METHOD}) %}{% endif %}
{% if SPARKNET_HTTP_SIMULATE_GATEWAY is defined and SPARKNET_HTTP_SIMULATE_GATEWAY | string | length > 0 %}{% set _ = overrides.update({'SPARKNET_HTTP_SIMULATE_GATEWAY': SPARKNET_HTTP_SIMULATE_GATEWAY}) %}{% endif %}
{% set env = env | combine(overrides) %}
{% for k, v in env.items() %}
{{ k }}={{ v }}
{% endfor %}
# BIND is fixed at 0.0.0.0:8080: the healthcheck and the webapp both reach the
# service on :8080, so this is not gateway-configurable.
SPARKNET_HTTP_BIND=0.0.0.0:8080
