authoritative;

default-lease-time 600;
max-lease-time 7200;

ddns-update-style none;

subnet {{ wifi_subnet_cidr.split('/')[0] }} netmask {{ '255.255.255.0' }} {
  range {{ wifi_dhcp_range_start }} {{ wifi_dhcp_range_end }};
  option routers {{ wifi_router_ip }};
  option subnet-mask 255.255.255.0;
  option domain-name-servers 1.1.1.1, 8.8.8.8;
} 