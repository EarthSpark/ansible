
x-app-env: &app_env
  APP_ENV: production
  DATABASE_URL: postgresql://{{ postgres_user }}:{{ postgres_password }}@postgres:5432/{{ postgres_db }}

x-logging: &default_logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "3"

services:
  postgres:
    image: postgres:14
    environment:
      POSTGRES_DB: {{ postgres_db }}
      POSTGRES_USER: {{ postgres_user }}
      POSTGRES_PASSWORD: {{ postgres_password }}
    volumes:
      - pg_data:/var/lib/postgresql/data
    logging: *default_logging
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ postgres_user }} -d {{ postgres_db }} -h localhost"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  # The single webapp service. Hypercorn binds two ASGI listeners in one
  # process: port 5000 for public traffic (mapped externally to host port 80),
  # port 5001 for internal admin/proxy endpoints (NOT mapped — only reachable
  # from inside the container via `docker compose exec`).
  #
  # On ground deployments the FastAPI lifespan spawns the Ohm subprocess (the
  # binary is baked into the image at /usr/local/bin/ohm) and owns it for the
  # lifetime of the container. The container needs the host's gateway serial
  # device passed in for that to work.
  app:
    image: {{ sparkmeter_image }}
    command: /app/run/webapp
    environment:
      <<: *app_env
      OHM_BINARY: /usr/local/bin/ohm
    ports:
      - "80:5000"
    devices:
      - "{{ usb_gateway_device }}:/dev/gateway"
    group_add:
      - "{{ dialout_gid }}"
    depends_on:
      postgres:
        condition: service_healthy
    logging: *default_logging
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://localhost:5000/health || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 10

  symmetricds:
    image: {{ symmetricds_image }}
    pull_policy: always
    env_file:
      - {{ compose_env_dir }}/prod-symmetricds.env
    network_mode: host
    logging: *default_logging
    healthcheck:
      test: ["CMD-SHELL", "nc -z localhost ${SYMDS_PORT:-31415}"]
      interval: 10s
      timeout: 5s
      retries: 10


volumes:
  pg_data: 