
x-app-env: &app_env
  APP_ENV: production
  DATABASE_URL: postgresql://{{ postgres_user }}:{{ postgres_password }}@postgres:5432/{{ postgres_db }}

x-logging: &default_logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "3"

services:
  postgres:
    image: postgres:18
    environment:
      POSTGRES_DB: {{ postgres_db }}
      POSTGRES_USER: {{ postgres_user }}
      POSTGRES_PASSWORD: {{ postgres_password }}
    volumes:
      - pg_data:/var/lib/postgresql/data
    logging: *default_logging
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ postgres_user }} -d {{ postgres_db }} -h localhost"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  # The single webapp service. Hypercorn binds two ASGI listeners in one
  # process: port 5000 for public traffic (mapped externally to host port 80),
  # port 5001 for internal admin/proxy endpoints (NOT mapped — only reachable
  # from inside the container via `docker compose exec`).
  #
  # The metering provider runs as its own service (sparknet-http); the webapp
  # reaches it over METERING_PROVIDER_URL. The webapp no longer owns the
  # gateway serial device — that moves to sparknet-http, which drives the radio.
  app:
    image: {{ sparkmeter_image }}
    command: /app/run/webapp
    environment:
      <<: *app_env
      METERING_PROVIDER_URL: http://sparknet-http:8080
    ports:
      - "80:5000"
    depends_on:
      postgres:
        condition: service_healthy
      sparknet-http:
        condition: service_started
    logging: *default_logging
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://localhost:5000/health || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 10

  # Metering provider: the SparkNet controller core with an HTTP+SSE API.
  # It drives the gateway radio over the host's serial device (passed in here
  # plus the dialout group) and serves the API on port 8080, which the webapp
  # reaches via METERING_PROVIDER_URL. Configured declaratively through
  # SPARKNET_HTTP_* env vars, which the image entrypoint maps to CLI flags.
  sparknet-http:
    image: {{ sparknet_http_image }}
    environment:
      SPARKNET_HTTP_BIND: "0.0.0.0:8080"
      SPARKNET_HTTP_DEVICE: /dev/gateway
    devices:
      - "{{ usb_gateway_device }}:/dev/gateway"
    group_add:
      - "{{ dialout_gid }}"
    logging: *default_logging
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:8080/healthz >/dev/null 2>&1 || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 10

  symmetricds:
    image: {{ symmetricds_image }}
    pull_policy: always
    env_file:
      - {{ compose_env_dir }}/prod-symmetricds.env
    network_mode: host
    logging: *default_logging
    healthcheck:
      test: ["CMD-SHELL", "nc -z localhost ${SYMDS_PORT:-31415}"]
      interval: 10s
      timeout: 5s
      retries: 10


volumes:
  pg_data: 