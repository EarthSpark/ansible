
x-app-env: &app_env
  APP_ENV: production
  DATABASE_URL: postgresql://{{ postgres_user }}:{{ postgres_password }}@postgres:5432/{{ postgres_db }}
  SM_SECRET_KEY: "{{ sm_secret_key }}"
  SM_SECURITY_PASSWORD_SALT: "{{ sm_security_password_salt }}"
{% if sm_serial %}
  SM_SERIAL: "{{ sm_serial }}"
{% endif %}
{% if sm_ground_name %}
  SM_GROUND_NAME: "{{ sm_ground_name }}"
{% endif %}
{% if sm_api_endpoint %}
  SM_API_ENDPOINT: "{{ sm_api_endpoint }}"
{% endif %}
{% if sparkcloud_api_key %}
  SM_SPARKCLOUD_API_KEY: "{{ sparkcloud_api_key }}"
{% endif %}

x-logging: &default_logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "3"

services:
  postgres:
    image: postgres:18
    environment:
      POSTGRES_DB: {{ postgres_db }}
      POSTGRES_USER: {{ postgres_user }}
      POSTGRES_PASSWORD: {{ postgres_password }}
    volumes:
      - pg_data:/var/lib/postgresql
    networks:
      - sparkapp
    logging: *default_logging
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ postgres_user }} -d {{ postgres_db }} -h localhost"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  # The single webapp service. Hypercorn binds two ASGI listeners in one
  # process: port 5000 for public traffic (mapped externally to host port 80),
  # port 5001 for internal admin/proxy endpoints (NOT mapped — only reachable
  # from inside the container via `docker compose exec`).
  #
  # The metering provider runs as its own service (sparknet-http) in its own
  # compose project; the webapp reaches it over METERING_PROVIDER_URL by service
  # name on the shared external sparkapp network. There is no depends_on across
  # projects — the webapp reaches the provider over HTTP and retries.
  app:
    image: {{ thundercloud_image }}
    command: /app/run/webapp
    environment:
      <<: *app_env
      METERING_PROVIDER_URL: "{{ metering_provider_url | default('http://sparknet-http:8080') }}"
    ports:
      - "80:5000"
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - sparkapp
    logging: *default_logging
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://localhost:5000/health || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 10

  symmetricds:
    image: {{ symmetricds_image }}
    pull_policy: always
    env_file:
      - {{ compose_env_dir }}/prod-symmetricds.env
    network_mode: host
    logging: *default_logging
    healthcheck:
      test: ["CMD-SHELL", "nc -z localhost ${SYMDS_PORT:-31415}"]
      interval: 10s
      timeout: 5s
      retries: 10


volumes:
  pg_data:

networks:
  sparkapp:
    external: true
